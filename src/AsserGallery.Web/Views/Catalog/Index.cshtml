@model AsserGallery.Application.Common.Models.PaginatedList<ProductDto>
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["Catalog"];
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
    var colors = ViewBag.Colors as List<ColorDto> ?? new List<ColorDto>();
    var selectedCatId = ViewBag.CategoryId as int?;
    var selectedColorId = ViewBag.ColorId as int?;
    var search = ViewBag.Search as string;
    var onlyInStock = (bool)(ViewBag.OnlyInStock ?? false);
    var sortBy = ViewBag.SortBy as string;
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">@Localizer["Catalog"]</h2>
    <p class="text-muted small">@(isArabic ? "استعرض كافة الموديلات المتوفرة لدينا مع إمكانية التصفية الفورية" : "Browse all available clothing models with real-time filters")</p>
</div>

<!-- Search & Filters Container (Realtime Auto-Submit) -->
<div class="card-custom p-3 p-md-4 mb-4">
    <form id="catalogFilterForm" method="get" asp-controller="Catalog" asp-action="Index">
        <div class="row g-3 align-items-end">
            <!-- Search Keyword with Debounce -->
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-muted">@(isArabic ? "البحث بالاسم أو الوصف" : "Search Keyword")</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="catalogSearchInput" name="search" value="@search" class="form-control border-start-0" placeholder="@Localizer["SearchPlaceholder"]" autocomplete="off" />
                </div>
            </div>

            <!-- Category Filter -->
            <div class="col-6 col-md-3">
                <label class="form-label small fw-bold text-muted">@Localizer["Categories"]</label>
                <select name="categoryId" class="form-select" onchange="this.form.submit()">
                    <option value="">@Localizer["AllCategories"]</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(selectedCatId == cat.Id)">@(isArabic ? cat.ArabicName : cat.Name)</option>
                    }
                </select>
            </div>

            <!-- Color Filter -->
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-muted">@Localizer["Colors"]</label>
                <select name="colorId" class="form-select" onchange="this.form.submit()">
                    <option value="">@(isArabic ? "جميع الألوان" : "All Colors")</option>
                    @foreach (var c in colors)
                    {
                        <option value="@c.Id" selected="@(selectedColorId == c.Id)">@(isArabic ? c.ArabicName : c.Name)</option>
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-muted">@(isArabic ? "الترتيب حسب" : "Sort By")</label>
                <select name="sortBy" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(sortBy))">@(isArabic ? "المميز والأحدث" : "Featured & Newest")</option>
                    <option value="price_asc" selected="@(sortBy == "price_asc")">@(isArabic ? "السعر: من الأقل للأعلى" : "Price: Low to High")</option>
                    <option value="price_desc" selected="@(sortBy == "price_desc")">@(isArabic ? "السعر: من الأعلى للأقل" : "Price: High to Low")</option>
                    <option value="name_asc" selected="@(sortBy == "name_asc")">@(isArabic ? "الاسم أ - ي" : "Name A-Z")</option>
                </select>
            </div>

            <!-- Reset Action -->
            <div class="col-6 col-md-1 d-flex gap-1">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary w-100" title="@Localizer["ClearFilters"]">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </div>

        <!-- In-Stock Only Toggle & Results Count -->
        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="inStockSwitch" name="onlyInStock" value="true" checked="@onlyInStock" onchange="this.form.submit()">
                <label class="form-check-label small fw-bold" for="inStockSwitch">
                    <i class="bi bi-check2-circle text-success me-1"></i> @Localizer["InStockOnly"]
                </label>
            </div>
            <span class="text-muted small">@Model.TotalCount @(isArabic ? "منتج تم العثور عليه" : "products found")</span>
        </div>
    </form>
</div>

<!-- Products Grid -->
@if (!Model.Items.Any())
{
    <div class="card-custom p-5 text-center my-4">
        <i class="bi bi-inbox text-muted fs-1 mb-2"></i>
        <h5 class="fw-bold mb-1">@(isArabic ? "لم نجد منتجات تطابق بحثك" : "No products matched your criteria")</h5>
        <p class="text-muted small mb-3">@(isArabic ? "جرب تغيير كلمات البحث أو إزالة بعض الفلاتر" : "Try changing search terms or clearing filters")</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-dark btn-sm rounded-pill px-3">@Localizer["ClearFilters"]</a>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4 mb-5">
        @foreach (var product in Model.Items)
        {
            <div class="col">
                <div class="product-card">
                    <!-- Image -->
                    <div class="product-card-img-wrapper">
                        @if (product.DiscountPercentage.HasValue)
                        {
                            <span class="discount-badge">-@product.DiscountPercentage% OFF</span>
                        }
                        
                        @if (product.Status == ProductStatus.OutOfStock)
                        {
                            <span class="badge bg-danger position-absolute bottom-0 start-0 m-2 z-2">@Localizer["OutOfStock"]</span>
                        }
                        else if (product.Status == ProductStatus.LimitedStock)
                        {
                            <span class="badge bg-warning text-dark position-absolute bottom-0 start-0 m-2 z-2">@Localizer["LimitedStock"]</span>
                        }

                        <img src="@(product.PrimaryImageUrl ?? "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=600&auto=format&fit=crop&q=80")" 
                             alt="@(isArabic ? product.ArabicName : product.Name)" 
                             class="product-card-img" />
                    </div>

                    <!-- Card Body -->
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <span class="text-muted small text-truncate">@(isArabic ? product.SubCategoryArabicName : product.SubCategoryName)</span>
                        <h6 class="fw-bold mb-1 text-truncate" title="@(isArabic ? product.ArabicName : product.Name)">
                            @(isArabic ? product.ArabicName : product.Name)
                        </h6>

                        <!-- Color Swatch Dots -->
                        <div class="color-swatches-row">
                            @foreach (var variant in product.Variants.Take(5))
                            {
                                <span class="color-dot" style="background-color: @variant.ColorHexCode;" title="@(isArabic ? variant.ColorArabicName : variant.ColorName) (@variant.Quantity)"></span>
                            }
                            @if (product.Variants.Count > 5)
                            {
                                <span class="text-muted small ms-1">+@(product.Variants.Count - 5)</span>
                            }
                        </div>

                        <!-- Price -->
                        <div class="price-block mt-auto pt-2">
                            <span class="price-current">@((product.DiscountedPrice ?? product.Price).ToString("N0")) @Localizer["Currency"]</span>
                            @if (product.DiscountedPrice.HasValue)
                            {
                                <span class="price-original">@product.Price.ToString("N0")</span>
                            }
                        </div>

                        <!-- CTA Button -->
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-primary-action mt-2">
                            @(isArabic ? "تفاصيل وطلب" : "Details & Order")
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center my-4">
            <ul class="pagination pagination-sm">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.PageNumber - 1)" 
                       asp-route-search="@search"
                       asp-route-categoryId="@selectedCatId"
                       asp-route-colorId="@selectedColorId"
                       asp-route-onlyInStock="@onlyInStock"
                       asp-route-sortBy="@sortBy">
                        <i class="bi bi-chevron-@(isArabic ? "right" : "left")"></i>
                    </a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@p" 
                           asp-route-search="@search"
                           asp-route-categoryId="@selectedCatId"
                           asp-route-colorId="@selectedColorId"
                           asp-route-onlyInStock="@onlyInStock"
                           asp-route-sortBy="@sortBy">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.PageNumber + 1)" 
                       asp-route-search="@search"
                       asp-route-categoryId="@selectedCatId"
                       asp-route-colorId="@selectedColorId"
                       asp-route-onlyInStock="@onlyInStock"
                       asp-route-sortBy="@sortBy">
                        <i class="bi bi-chevron-@(isArabic ? "left" : "right")"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
