@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["ContactUs"];
    var settings = ViewBag.Settings as StoreSettingsDto;
    var whatsAppPhone = settings?.WhatsAppNumber ?? "201000000000";
    var messengerUser = settings?.MessengerUsername ?? "assergallery";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="text-center mb-5">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-2">
                @(isArabic ? "خدمة العملاء على مدار الساعة" : "Customer Support & Direct Orders")
            </span>
            <h2 class="display-6 fw-bold">@Localizer["ContactUs"]</h2>
            <p class="text-muted">
                @(isArabic ? "يسعدنا دائماً تواصلكم معنا للطلب المباشر، الاستفسار عن المقاسات، أو طلبات الجملة والتوصيل." : "We're always delighted to assist you with orders, size advice, or inquiries.")
            </p>
        </div>

        <!-- Quick Direct Contact Channels -->
        <div class="row g-3 mb-5">
            <div class="col-md-6">
                <a href="https://wa.me/@whatsAppPhone" target="_blank" class="card-custom p-4 text-decoration-none d-flex align-items-center gap-3 h-100 shadow-sm border-start border-4 border-success">
                    <div class="rounded-circle bg-success text-white p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-whatsapp"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-main mb-1">WhatsApp Direct</h5>
                        <p class="text-muted small mb-0">+@whatsAppPhone</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="https://m.me/@messengerUser" target="_blank" class="card-custom p-4 text-decoration-none d-flex align-items-center gap-3 h-100 shadow-sm border-start border-4 border-primary">
                    <div class="rounded-circle bg-primary text-white p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-messenger"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-main mb-1">Facebook Messenger</h5>
                        <p class="text-muted small mb-0">m.me/@messengerUser</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Contact / Callback Form -->
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <h4 class="fw-bold mb-3">@(isArabic ? "أرسل لنا استفسارك أو طلب معاودة اتصال" : "Send Inquiry or Request a Callback")</h4>
            
            <form asp-controller="Contact" asp-action="Submit" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isArabic ? "الاسم" : "Full Name") *</label>
                        <input type="text" name="customerName" class="form-control rounded-3" required placeholder="Ahmed Ali" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isArabic ? "رقم الهاتف / واتساب" : "Phone Number") *</label>
                        <input type="tel" name="phoneNumber" class="form-control rounded-3" required placeholder="010XXXXXXXX" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">@(isArabic ? "طريقة التواصل المفضلة" : "Preferred Channel")</label>
                        <select name="preferredChannel" class="form-select rounded-3">
                            <option value="@ContactChannel.WhatsApp">WhatsApp</option>
                            <option value="@ContactChannel.Phone">Phone Call</option>
                            <option value="@ContactChannel.Messenger">Messenger</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">@(isArabic ? "الرسالة أو الاستفسار" : "Message / Inquiries")</label>
                        <textarea name="message" class="form-control rounded-3" rows="4" placeholder="@(isArabic ? "اكتب استفسارك هنا..." : "Type your message or inquiry here...")"></textarea>
                    </div>
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-dark w-100 py-3 rounded-pill fw-bold shadow">
                            <i class="bi bi-send-fill me-2"></i> @(isArabic ? "إرسال الرسالة" : "Submit Message")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
