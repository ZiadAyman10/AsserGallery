@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var currentLang = isRtl ? "ar" : "en";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentLang" dir="@(isRtl ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @Localizer["AppName"]</title>
    
    <!-- Bootstrap CSS (RTL/LTR Aware) -->
    @if (isRtl)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    }
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Design System Layer -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Brand Navbar -->
    <header>
        <nav class="navbar-custom">
            <div class="container-fluid max-w-7xl d-flex align-items-center justify-content-between">
                <!-- Brand Logo (Combined Gallery + Clothes Hanger) -->
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3"
                         style="width:38px;height:38px;background:linear-gradient(135deg,#2563eb,#7c3aed);flex-shrink:0;box-shadow:0 2px 8px rgba(37,99,235,0.3);">
                        <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <!-- Gallery Frame -->
                            <rect x="3" y="6" width="26" height="21" rx="3" stroke="white" stroke-width="2" fill="none"/>
                            <!-- Inner gallery line -->
                            <line x1="3" y1="12" x2="29" y2="12" stroke="white" stroke-width="1.2" opacity="0.6"/>
                            <!-- Clothes Hanger Hook -->
                            <path d="M16 3 C16 1.5, 18 1.5, 18 3 C18 4.5, 16 5, 16 6" stroke="white" stroke-width="2" fill="none" stroke-linecap="round"/>
                            <!-- Clothes Hanger Triangle / Shoulders -->
                            <path d="M7 19 L16 13 L25 19" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <line x1="8" y1="19" x2="24" y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                            <!-- Small accent dress/tag dot -->
                            <circle cx="16" cy="22" r="1.5" fill="white"/>
                        </svg>
                    </div>
                    <span class="brand-name">@Localizer["AppName"]</span>
                </a>

                <!-- Desktop Nav Links -->
                <div class="d-none d-md-flex align-items-center gap-2">
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-1"></i> @Localizer["Home"]
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")" asp-controller="Catalog" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap me-1"></i> @Localizer["Catalog"]
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">
                        <i class="bi bi-chat-dots me-1"></i> @Localizer["ContactUs"]
                    </a>
                </div>

                <!-- Utilities: Language, Theme & Staff Icon -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Language Switcher -->
                    @if (isRtl)
                    {
                        <a href="/Culture/SetLanguage?culture=en&returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn-lang-toggle" title="Switch to English">
                            <i class="bi bi-globe"></i> English
                        </a>
                    }
                    else
                    {
                        <a href="/Culture/SetLanguage?culture=ar&returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn-lang-toggle" title="التحويل للغة العربية">
                            <i class="bi bi-globe"></i> عربي
                        </a>
                    }

                    <!-- Theme Toggle -->
                    <button class="btn-theme-toggle" type="button" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
                        <i class="bi bi-sun-fill theme-icon-sun text-warning" style="display:none;"></i>
                        <i class="bi bi-moon-stars-fill theme-icon-moon text-primary"></i>
                    </button>

                    <!-- Staff / Admin Icon Only (Fix 8: Icon in header for staff only, no prominent text) -->
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-theme-toggle ms-1" title="@(isRtl ? "بوابة الإدارة / الموظفين" : "Staff / Admin Portal")" aria-label="Staff Portal">
                        <i class="bi bi-shield-lock"></i>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Public Content -->
    <main class="flex-grow-1 py-4">
        <div class="container-fluid px-3 px-md-4 max-w-7xl">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <!-- Mobile Bottom Navigation Bar (§6) -->
    <nav class="mobile-bottom-nav">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="bi bi-house-door-fill fs-5"></i>
            <span>@Localizer["Home"]</span>
        </a>
        <a asp-controller="Catalog" asp-action="Index" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")">
            <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
            <span>@Localizer["Catalog"]</span>
        </a>
        <a asp-controller="Contact" asp-action="Index" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")">
            <i class="bi bi-chat-dots-fill fs-5"></i>
            <span>@Localizer["ContactUs"]</span>
        </a>
    </nav>

    <!-- Footer -->
    <footer class="border-top py-4 mt-auto" style="border-color: var(--border-main) !important; background: var(--bg-surface);">
        <div class="container-fluid max-w-7xl text-center">
            <div class="d-flex flex-wrap justify-content-center gap-3 mb-2 text-muted small">
                <span>&copy; @DateTime.UtcNow.Year @Localizer["AppName"]. @(isRtl ? "جميع الحقوق محفوظة." : "All rights reserved.")</span>
                <span>•</span>
                <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-muted">@Localizer["Catalog"]</a>
                <span>•</span>
                <a asp-controller="Contact" asp-action="Index" class="text-decoration-none text-muted">@Localizer["ContactUs"]</a>
            </div>
            <p class="text-muted small mb-0">@(isRtl ? "تشكيلة أزياء وموديلات راقية ومختارة بعناية. طلب فوري وتوصيل سريع." : "High-quality curated fashion collection. Direct orders via WhatsApp & Messenger.")</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
