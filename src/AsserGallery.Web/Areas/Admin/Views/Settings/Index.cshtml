@model StoreSettingsDto
@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isRtl ? "إعدادات المتجر والهوية" : "Store Settings & Branding";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">@(isRtl ? "إعدادات المتجر والهوية التجارية" : "Store Settings & Configuration")</h4>
    <p class="text-muted small mb-0">@(isRtl ? "تحديد بيانات المتجر، قنوات التواصل والطلب عبر واتساب وفيسبوك، والتحكم في ظهور المنتجات." : "Configure store branding, order communication channels, and availability behaviors.")</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Store Brand Name (English) *</label>
                        <input type="text" name="StoreName" class="form-control" value="@Model.StoreName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">اسم المتجر (بالعربي) *</label>
                        <input type="text" name="StoreArabicName" class="form-control text-end" value="@Model.StoreArabicName" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isRtl ? "رقم هاتف طلبات واتساب *" : "Primary WhatsApp Order Phone *")</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-whatsapp text-success"></i></span>
                            <input type="text" name="WhatsAppNumber" class="form-control" value="@Model.WhatsAppNumber" required placeholder="201012345678" />
                        </div>
                        <span class="text-muted extra-small">@(isRtl ? "اكتب كود الدولة بدون علامة + (مثال: 201012345678)" : "Include country code without '+' (e.g. 201012345678)")</span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isRtl ? "معرف صفحة ماسنجر *" : "Facebook Messenger Handle *")</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-messenger text-primary"></i></span>
                            <input type="text" name="MessengerUsername" class="form-control" value="@Model.MessengerUsername" required placeholder="assergallery.eg" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Currency Code (EN) *</label>
                        <input type="text" name="Currency" class="form-control" value="@Model.Currency" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">رمز العملة (AR) *</label>
                        <input type="text" name="CurrencyArabic" class="form-control text-end" value="@Model.CurrencyArabic" required />
                    </div>

                    <div class="col-12 pt-3 border-top">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" name="HideOutOfStock" id="hideOutOfStockSwitch" value="true" checked="@Model.HideOutOfStock" />
                            <label class="form-check-label fw-bold small" for="hideOutOfStockSwitch">
                                @(isRtl ? "إخفاء المنتجات التي نفدت كميتها تماماً من كتالوج الموقع العام" : "Automatically hide out-of-stock items completely on the public catalog")
                            </label>
                        </div>
                        <span class="text-muted extra-small ms-4 d-block">@(isRtl ? "إذا لم يتم التفعيل، ستظل المنتجات التي نفدت ظاهرة مع شارة 'نفدت الكمية'." : "If unchecked, out-of-stock items remain visible with an 'Out of Stock' badge.")</span>
                    </div>

                    <div class="col-12 mt-4 text-end">
                        <button type="submit" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow">
                            <i class="bi bi-check2-circle me-1"></i> @(isRtl ? "حفظ الإعدادات" : "Save Settings")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
