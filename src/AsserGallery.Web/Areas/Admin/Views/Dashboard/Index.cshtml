@model DashboardSummaryDto
@using System.Globalization
@using System.Text.Json
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "لوحة التحكم العامة" : "Dashboard Overview";
    var currency = Localizer["Currency"].Value;

    // Serialize chart data for client-side Chart.js
    var trendLabels = Model.MonthlyTrends.Select(t => t.MonthLabel).ToList();
    var trendRevenues = Model.MonthlyTrends.Select(t => t.Revenue).ToList();
    var trendExpenses = Model.MonthlyTrends.Select(t => t.Expenses).ToList();
    var trendProfits = Model.MonthlyTrends.Select(t => t.Profit).ToList();

    var catLabels = Model.CategoryBreakdowns.Select(c => c.CategoryName).ToList();
    var catCounts = Model.CategoryBreakdowns.Select(c => c.ProductCount).ToList();
    var catStocks = Model.CategoryBreakdowns.Select(c => c.TotalStock).ToList();
}

<!-- Key Metric Stat KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Total Products -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-kpi-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-kpi-label">@Localizer["TotalProducts"]</span>
                <span class="p-2 rounded-circle bg-primary bg-opacity-10 text-primary"><i class="bi bi-tags fs-5"></i></span>
            </div>
            <div class="stat-kpi-value">@Model.TotalProductsCount</div>
            <div class="small text-muted mt-1">
                <span class="text-success fw-bold">@Model.InStockProductsCount</span> @(isArabic ? "متوفر" : "in stock") • 
                <span class="text-warning fw-bold">@Model.LimitedStockProductsCount</span> @(isArabic ? "محدود" : "limited") • 
                <span class="text-danger fw-bold">@Model.OutOfStockProductsCount</span> @(isArabic ? "نفد" : "out")
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-kpi-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-kpi-label">@Localizer["TotalRevenue"]</span>
                <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success"><i class="bi bi-currency-exchange fs-5"></i></span>
            </div>
            <div class="stat-kpi-value text-success">@Model.TotalRevenue.ToString("N0") <small class="fs-6 fw-normal">@currency</small></div>
            <div class="small text-muted mt-1">
                @(isArabic ? $"من إجمالي {Model.TotalOrdersCount} طلب عميل مؤكد" : $"From {Model.TotalOrdersCount} confirmed customer orders")
            </div>
        </div>
    </div>

    <!-- Net Profit -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-kpi-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-kpi-label">@Localizer["NetProfit"]</span>
                <span class="p-2 rounded-circle bg-info bg-opacity-10 text-info"><i class="bi bi-graph-up-arrow fs-5"></i></span>
            </div>
            <div class="stat-kpi-value @(Model.NetProfit >= 0 ? "text-primary" : "text-danger")">
                @Model.NetProfit.ToString("N0") <small class="fs-6 fw-normal">@currency</small>
            </div>
            <div class="small text-muted mt-1">
                @(isArabic ? $"الإيرادات ({Model.TotalRevenue.ToString("N0")}) - المصروفات ({Model.TotalExpenses.ToString("N0")})" : $"Income ({Model.TotalRevenue.ToString("N0")}) - Expenses ({Model.TotalExpenses.ToString("N0")})")
            </div>
        </div>
    </div>

    <!-- Pending Customer Requests -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-kpi-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-kpi-label">@Localizer["CustomerRequests"]</span>
                <span class="p-2 rounded-circle bg-warning bg-opacity-10 text-warning"><i class="bi bi-bell-fill fs-5"></i></span>
            </div>
            <div class="stat-kpi-value text-warning">@Model.PendingCustomerRequestsCount</div>
            <div class="small mt-1">
                <a asp-area="Admin" asp-controller="CustomerRequests" asp-action="Index" class="text-decoration-none fw-semibold">
                    @(isArabic ? "عرض طلبات المعاودة للمتابعة" : "View callbacks to follow up") <i class="bi bi-arrow-@(isArabic ? "left" : "right")"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Shortcuts -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card-custom p-3 d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <span class="fw-bold small text-muted">@Localizer["QuickActions"]:</span>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-sm btn-dark rounded-pill">
                    <i class="bi bi-plus-circle me-1"></i> @Localizer["AddNewProduct"]
                </a>
                <a asp-area="Admin" asp-controller="Sales" asp-action="Create" class="btn btn-sm btn-success rounded-pill">
                    <i class="bi bi-cart-plus me-1"></i> @Localizer["NewSaleInvoice"]
                </a>
                <a asp-area="Admin" asp-controller="Finances" asp-action="Create" class="btn btn-sm btn-outline-dark rounded-pill">
                    <i class="bi bi-cash me-1"></i> @Localizer["RecordExpense"]
                </a>
                <a asp-area="Admin" asp-controller="Facebook" asp-action="Index" class="btn btn-sm btn-primary rounded-pill">
                    <i class="bi bi-facebook me-1"></i> @Localizer["FacebookPublishing"]
                </a>
                <a asp-area="Admin" asp-controller="Sales" asp-action="ExportCsv" class="btn btn-sm btn-outline-success rounded-pill">
                    <i class="bi bi-file-earmark-arrow-down me-1"></i> @Localizer["ExportCsv"]
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Analytics & Interactive Visual Charts -->
<div class="row g-4 mb-4">
    <!-- Revenue vs Expenses Line Chart -->
    <div class="col-lg-8">
        <div class="card-custom h-100 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="fw-bold mb-0">@Localizer["RevenueVsExpenses"]</h5>
                    <p class="text-muted small mb-0">@(isArabic ? "مقارنة شهرية بين إيرادات المبيعات وتكاليف التشغيل" : "Monthly comparison of sales revenue vs. operating expenses")</p>
                </div>
                <span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i> @(isArabic ? "آخر 6 أشهر" : "Last 6 Months")</span>
            </div>
            <div style="position: relative; height: 280px; width: 100%;">
                <canvas id="revenueTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Stock Availability Doughnut Chart -->
    <div class="col-lg-4">
        <div class="card-custom h-100 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="fw-bold mb-0">@Localizer["StockHealth"]</h5>
                    <p class="text-muted small mb-0">@(isArabic ? "نسبة توزيع حالة المنتجات" : "Stock availability ratio")</p>
                </div>
                <i class="bi bi-pie-chart text-muted fs-5"></i>
            </div>
            <div style="position: relative; height: 220px; width: 100%;">
                <canvas id="stockDistributionChart"></canvas>
            </div>
            <div class="d-flex justify-content-around text-center pt-3 border-top mt-3">
                <div>
                    <div class="fw-bold text-success">@Model.InStockProductsCount</div>
                    <div class="extra-small text-muted">@Localizer["Available"]</div>
                </div>
                <div>
                    <div class="fw-bold text-warning">@Model.LimitedStockProductsCount</div>
                    <div class="extra-small text-muted">@Localizer["LimitedStock"]</div>
                </div>
                <div>
                    <div class="fw-bold text-danger">@Model.OutOfStockProductsCount</div>
                    <div class="extra-small text-muted">@Localizer["OutOfStock"]</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Category Breakdown & Top Selling Products -->
<div class="row g-4 mb-4">
    <!-- Category Breakdown Chart -->
    <div class="col-lg-6">
        <div class="card-custom h-100 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="fw-bold mb-0">@Localizer["CategoryDistribution"]</h5>
                    <p class="text-muted small mb-0">@(isArabic ? "عدد المنتجات وإجمالي القطع في كل قسم" : "Number of products and total stock on hand per category")</p>
                </div>
                <i class="bi bi-bar-chart-steps text-muted fs-5"></i>
            </div>
            <div style="position: relative; height: 250px; width: 100%;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Top Selling Products -->
    <div class="col-lg-6">
        <div class="card-custom h-100 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="fw-bold mb-0">@Localizer["TopSellingProducts"]</h5>
                    <p class="text-muted small mb-0">@(isArabic ? "الأكثر مبيعاً حسب عدد القطع المباعة وحجم المبيعات" : "Best sellers by total units sold & sales volume")</p>
                </div>
                <i class="bi bi-trophy text-warning fs-5"></i>
            </div>

            @if (!Model.TopSellingProducts.Any())
            {
                <p class="text-muted small my-4 text-center">@(isArabic ? "لم يتم تسجيل أي مبيعات حتى الآن." : "No product sales recorded yet.")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@(isArabic ? "المنتج" : "Product")</th>
                                <th class="text-center">@Localizer["UnitsSold"]</th>
                                <th class="text-end">@Localizer["Revenue"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.TopSellingProducts)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                            @item.ProductName
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 fw-bold">@item.QuantitySold @(isArabic ? "قطعة" : "pcs")</span>
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        @item.TotalRevenue.ToString("N0") @currency
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Tables: Recent Sales & Inquiries -->
<div class="row g-4 mb-4">
    <!-- Recent Sales -->
    <div class="col-lg-7">
        <div class="card-custom h-100 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0">@Localizer["RecentSalesOrders"]</h5>
                <a asp-area="Admin" asp-controller="Sales" asp-action="Index" class="small text-decoration-none text-muted fw-semibold">@Localizer["ViewAll"]</a>
            </div>

            @if (!Model.RecentSales.Any())
            {
                <p class="text-muted small my-3">@(isArabic ? "لا توجد فواتير مبيعات مسجلة بعد." : "No sales registered yet.")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["InvoiceNumber"]</th>
                                <th>@Localizer["Customer"]</th>
                                <th>@(isArabic ? "القطع" : "Items")</th>
                                <th>@Localizer["Amount"]</th>
                                <th>@Localizer["Date"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model.RecentSales)
                            {
                                <tr>
                                    <td class="fw-bold"><a asp-area="Admin" asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id" class="text-decoration-none">@sale.SaleNumber</a></td>
                                    <td>@(sale.CustomerName ?? (isArabic ? "عميل مباشر" : "Direct Customer"))</td>
                                    <td><span class="badge bg-secondary">@sale.Items.Count @(isArabic ? "قطعة" : "item(s)")</span></td>
                                    <td class="fw-bold text-success">@sale.TotalAmount.ToString("N0") @currency</td>
                                    <td class="small text-muted">@sale.SaleDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Customer Inquiries -->
    <div class="col-lg-5">
        <div class="card-custom h-100 p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0">@Localizer["CustomerRequests"]</h5>
                <a asp-area="Admin" asp-controller="CustomerRequests" asp-action="Index" class="small text-decoration-none text-muted fw-semibold">@Localizer["ViewAll"]</a>
            </div>

            @if (!Model.RecentRequests.Any())
            {
                <p class="text-muted small my-3">@(isArabic ? "لا توجد طلبات عملاء معلقة." : "No pending customer requests.")</p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var req in Model.RecentRequests)
                    {
                        <div class="p-3 rounded-3 border d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-0">@req.CustomerName</h6>
                                <p class="text-muted small mb-0">@req.PhoneNumber • <span class="badge bg-info bg-opacity-10 text-info">@req.PreferredChannel</span></p>
                                @if (!string.IsNullOrWhiteSpace(req.ProductName))
                                {
                                    <span class="badge bg-light text-dark border small mt-1">@req.ProductName</span>
                                }
                            </div>
                            <a href="https://wa.me/@req.PhoneNumber" target="_blank" class="btn btn-sm btn-success rounded-circle" title="Open WhatsApp">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isDark = document.documentElement.getAttribute("data-theme") === "dark";
            const textColor = isDark ? "#adb5bd" : "#495057";
            const gridColor = isDark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.05)";
            const currencyLabel = "@currency";

            // 1. Revenue vs Expenses Line Chart
            const trendLabels = @Html.Raw(JsonSerializer.Serialize(trendLabels));
            const trendRevenues = @Html.Raw(JsonSerializer.Serialize(trendRevenues));
            const trendExpenses = @Html.Raw(JsonSerializer.Serialize(trendExpenses));

            const revenueDatasetLabel = @Html.Raw(JsonSerializer.Serialize(isArabic ? "إيرادات المبيعات" : "Sales Revenue"));
            const expenseDatasetLabel = @Html.Raw(JsonSerializer.Serialize(isArabic ? "المصروفات" : "Expenses"));

            const ctxTrend = document.getElementById('revenueTrendChart');
            if (ctxTrend) {
                new Chart(ctxTrend, {
                    type: 'line',
                    data: {
                        labels: trendLabels,
                        datasets: [
                            {
                                label: revenueDatasetLabel + ' (' + currencyLabel + ')',
                                data: trendRevenues,
                                borderColor: '#198754',
                                backgroundColor: 'rgba(25, 135, 84, 0.12)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointBackgroundColor: '#198754',
                                pointRadius: 4
                            },
                            {
                                label: expenseDatasetLabel + ' (' + currencyLabel + ')',
                                data: trendExpenses,
                                borderColor: '#dc3545',
                                backgroundColor: 'rgba(220, 53, 69, 0.08)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2,
                                pointBackgroundColor: '#dc3545',
                                pointRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { color: textColor, font: { family: 'inherit', size: 12 } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + Number(context.raw).toLocaleString() + ' ' + currencyLabel;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: gridColor },
                                ticks: { color: textColor }
                            },
                            y: {
                                grid: { color: gridColor },
                                ticks: {
                                    color: textColor,
                                    callback: function(value) { return value.toLocaleString() + ' ' + currencyLabel; }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Stock Distribution Doughnut Chart
            const inStock = @Model.InStockProductsCount;
            const limited = @Model.LimitedStockProductsCount;
            const outOfStock = @Model.OutOfStockProductsCount;

            const stockLabels = @Html.Raw(JsonSerializer.Serialize(isArabic ? new[] { "متوفر", "كمية محدودة", "نفدت الكمية" } : new[] { "In Stock", "Limited Stock", "Out of Stock" }));

            const ctxStock = document.getElementById('stockDistributionChart');
            if (ctxStock) {
                new Chart(ctxStock, {
                    type: 'doughnut',
                    data: {
                        labels: stockLabels,
                        datasets: [{
                            data: [inStock, limited, outOfStock],
                            backgroundColor: ['#198754', '#ffc107', '#dc3545'],
                            borderWidth: 2,
                            borderColor: isDark ? '#212529' : '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { color: textColor, font: { family: 'inherit', size: 11 } }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }

            // 3. Category Breakdown Bar Chart
            const catLabels = @Html.Raw(JsonSerializer.Serialize(catLabels));
            const catCounts = @Html.Raw(JsonSerializer.Serialize(catCounts));
            const catDatasetLabel = @Html.Raw(JsonSerializer.Serialize(isArabic ? "عدد المنتجات في القسم" : "Products in Category"));

            const ctxCategory = document.getElementById('categoryChart');
            if (ctxCategory && catLabels.length > 0) {
                new Chart(ctxCategory, {
                    type: 'bar',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            label: catDatasetLabel,
                            data: catCounts,
                            backgroundColor: 'rgba(13, 110, 253, 0.8)',
                            borderRadius: 6,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: {
                                grid: { color: gridColor },
                                ticks: { color: textColor }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: gridColor },
                                ticks: {
                                    color: textColor,
                                    stepSize: 1,
                                    precision: 0
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
