@model SaleDto
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? $"فاتورة — {Model.SaleNumber}" : $"Invoice — {Model.SaleNumber}";
    var currency = Localizer["Currency"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Localizer["SaleReceipt"]</h4>
        <p class="text-muted small mb-0">@Localizer["InvoiceNumber"] @Model.SaleNumber</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-@(isArabic ? "right" : "left") me-1"></i> @Localizer["BackToSales"]
        </a>
        <button type="button" class="btn btn-dark btn-sm rounded-pill" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> @Localizer["PrintInvoice"]
        </button>
    </div>
</div>

<div class="card-custom p-4 p-md-5 shadow-sm max-w-4xl mx-auto">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
        <div>
            <span class="badge-logo fs-4 px-3 py-1 d-inline-block mb-2">AG</span>
            <h4 class="fw-bold mb-0">@Localizer["AppName"]</h4>
            <p class="text-muted small mb-0">@(isArabic ? "القاهرة، مصر • طلب عبر المتجر الإلكتروني" : "Cairo, Egypt • Online WhatsApp Order")</p>
        </div>
        <div class="text-end">
            <h5 class="fw-bold text-success mb-1">@Localizer["PaidConfirmed"]</h5>
            <div class="small text-muted">@Localizer["InvoiceNumber"]: <strong>@Model.SaleNumber</strong></div>
            <div class="small text-muted">@Localizer["Date"]: <strong>@Model.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
        </div>
    </div>

    <!-- Customer Info -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <span class="text-muted small d-block">@Localizer["BilledTo"]</span>
            <h6 class="fw-bold mb-1">@(Model.CustomerName ?? (isArabic ? "عميل مباشر" : "Walk-in Customer"))</h6>
            <p class="text-muted small mb-0">@Localizer["Phone"]: @(Model.CustomerPhone ?? "—")</p>
        </div>
        <div class="col-sm-6 text-sm-end">
            <span class="text-muted small d-block">@Localizer["OrderNotes"]</span>
            <p class="small mb-0">@(Model.Notes ?? (isArabic ? "تسليم قياسي." : "Standard customer delivery."))</p>
        </div>
    </div>

    <!-- Items Table -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["ItemDescription"]</th>
                    <th>@Localizer["ColorVariant"]</th>
                    <th class="text-center">@Localizer["Qty"]</th>
                    <th class="text-end">@Localizer["UnitPrice"]</th>
                    <th class="text-end">@Localizer["Subtotal"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@(isArabic && !string.IsNullOrWhiteSpace(item.ProductArabicName) ? item.ProductArabicName : item.ProductName)</strong>
                            <div class="text-muted extra-small">@(isArabic ? item.ProductName : item.ProductArabicName)</div>
                        </td>
                        <td>
                            <span class="d-inline-flex align-items-center gap-1">
                                <span class="color-dot" style="width: 10px; height: 10px; background-color: @item.ColorHexCode;"></span>
                                <span>@(isArabic && !string.IsNullOrWhiteSpace(item.ColorArabicName) ? item.ColorArabicName : item.ColorName)</span>
                            </span>
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N0") @currency</td>
                        <td class="text-end fw-bold">@item.SubTotal.ToString("N0") @currency</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end fs-5">@Localizer["GrandTotal"]</th>
                    <th class="text-end fs-5 text-success">@Model.TotalAmount.ToString("N0") @currency</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="text-center text-muted small pt-3 border-top">
        @(isArabic ? "شكراً لتسوقكم مع آسر جاليري! جميع المنتجات أصلية وبضمان الجودة." : "Thank you for shopping with Asser Gallery! All items are quality guaranteed.")
    </div>
</div>
