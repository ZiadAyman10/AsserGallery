@model SaleDto
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? $"فاتورة مبيعات — {Model.SaleNumber}" : $"Invoice — {Model.SaleNumber}";
    var curr = isArabic ? "ج.م" : "EGP";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">@(isArabic ? "إيصال وفاتورة مبيعات" : "Sale Receipt")</h4>
        <p class="text-muted small mb-0">@(isArabic ? $"فاتورة رقم #{Model.SaleNumber}" : $"Invoice #{Model.SaleNumber}")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-@(isArabic ? "right" : "left") me-1"></i> @(isArabic ? "رجوع للمبيعات" : "Back to Sales")
        </a>
        <button type="button" class="btn btn-dark btn-sm rounded-pill" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> @(isArabic ? "طباعة الفاتورة" : "Print Invoice")
        </button>
    </div>
</div>

<div class="card-custom p-4 p-md-5 shadow-sm max-w-4xl mx-auto">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
        <div>
            <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2"
                 style="width:36px;height:36px;background:linear-gradient(135deg,#2563eb,#7c3aed);">
                <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="6" width="26" height="21" rx="3" stroke="white" stroke-width="2" fill="none"/>
                    <path d="M7 19 L16 13 L25 19" stroke="white" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>
            <h4 class="fw-bold mb-0">@(isArabic ? "آسر جاليري" : "Asser Gallery")</h4>
            <p class="text-muted small mb-0">@(isArabic ? "القاهرة، مصر • طلبات وتوصيل فوري" : "Cairo, Egypt • Online Store Order")</p>
        </div>
        <div class="text-end">
            <h5 class="fw-bold text-success mb-1">@(isArabic ? "تم الدفع / مؤكد" : "PAID / CONFIRMED")</h5>
            <div class="small text-muted">@(isArabic ? "رقم الفاتورة:" : "Invoice:") <strong>@Model.SaleNumber</strong></div>
            <div class="small text-muted">@(isArabic ? "التاريخ:" : "Date:") <strong>@Model.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
        </div>
    </div>

    <!-- Customer Info -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <span class="text-muted small d-block">@(isArabic ? "فاتورة إلى السيد/السيدة:" : "Billed To:")</span>
            <h6 class="fw-bold mb-1">@(Model.CustomerName ?? (isArabic ? "عميل مباشر" : "Walk-in Customer"))</h6>
            <p class="text-muted small mb-0">@(isArabic ? "الهاتف:" : "Phone:") @(Model.CustomerPhone ?? "—")</p>
        </div>
        <div class="col-sm-6 text-sm-end">
            <span class="text-muted small d-block">@(isArabic ? "ملاحظات الطلب:" : "Order Notes:")</span>
            <p class="small mb-0">@(Model.Notes ?? (isArabic ? "تسليم قياسي." : "Standard customer delivery."))</p>
        </div>
    </div>

    <!-- Items Table -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@(isArabic ? "بيان الصنف" : "Item Description")</th>
                    <th>@(isArabic ? "اللون" : "Color Variant")</th>
                    <th class="text-center">@(isArabic ? "الكمية" : "Qty")</th>
                    <th class="text-end">@(isArabic ? "سعر القطعة" : "Unit Price")</th>
                    <th class="text-end">@(isArabic ? "الإجمالي" : "Subtotal")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@(isArabic ? item.ProductArabicName : item.ProductName)</strong>
                            <div class="text-muted extra-small">@(isArabic ? item.ProductName : item.ProductArabicName)</div>
                        </td>
                        <td>
                            <span class="d-inline-flex align-items-center gap-1">
                                <span class="color-dot" style="width: 10px; height: 10px; background-color: @item.ColorHexCode;"></span>
                                <span>@(isArabic ? item.ColorArabicName : item.ColorName)</span>
                            </span>
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N0") @curr</td>
                        <td class="text-end fw-bold">@item.SubTotal.ToString("N0") @curr</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end fs-5">@(isArabic ? "إجمالي الفاتورة:" : "Total Amount:")</th>
                    <th class="text-end fs-5 text-success">@Model.TotalAmount.ToString("N0") @curr</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="text-center text-muted small pt-3 border-top">
        @(isArabic ? "شكراً لتسوقكم مع آسر جاليري! جميع منتجاتنا مضمونة الجودة والخامة." : "Thank you for shopping with Asser Gallery! All items are quality guaranteed.")
    </div>
</div>
