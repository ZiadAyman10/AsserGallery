@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["RegisterNewSale"].Value;
    var products = ViewBag.Products as IReadOnlyList<ProductDto> ?? new List<ProductDto>();
    var currency = Localizer["Currency"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Localizer["RegisterNewSale"]</h4>
        <p class="text-muted small mb-0">@(isArabic ? "تسجيل طلب عميل مؤكد والخصم التلقائي لكمية المخزون حسب اللون المحدد." : "Record a confirmed customer order. Selected variant stock will auto-decrement.")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-@(isArabic ? "right" : "left") me-1"></i> @Localizer["BackToSales"]
    </a>
</div>

<form asp-action="Create" method="post" id="registerSaleForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Customer & Order Meta -->
        <div class="col-lg-4">
            <div class="card-custom p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">@(isArabic ? "بيانات العميل والطلب" : "Customer & Details")</h5>
                
                <div class="mb-3">
                    <label class="form-label small fw-bold">@Localizer["CustomerName"]</label>
                    <input type="text" name="customerName" class="form-control" placeholder="@(isArabic ? "مثال: محمود حسن" : "e.g. Mahmoud Hassan")" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">@Localizer["Phone"]</label>
                    <input type="tel" name="customerPhone" class="form-control" placeholder="010XXXXXXXX" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">@Localizer["Date"]</label>
                    <input type="datetime-local" name="saleDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">@Localizer["OrderNotes"]</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="@(isArabic ? "عنوان الشحن، شركة التوصيل، طريقة الدفع..." : "Courier details, payment method, address...")"></textarea>
                </div>
            </div>
        </div>

        <!-- Order Items Selector -->
        <div class="col-lg-8">
            <div class="card-custom p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                    <h5 class="fw-bold mb-0">@Localizer["OrderItems"]</h5>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill" onclick="addSaleRow()">
                        <i class="bi bi-plus-lg me-1"></i> @Localizer["AddAnotherItem"]
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle" id="saleItemsTable">
                        <thead>
                            <tr>
                                <th style="width: 45%;">@Localizer["ItemDescription"]</th>
                                <th style="width: 20%;">@Localizer["Qty"]</th>
                                <th style="width: 25%;">@Localizer["UnitPrice"] (@currency)</th>
                                <th style="width: 10%;"></th>
                            </tr>
                        </thead>
                        <tbody id="saleItemsBody">
                            <tr class="sale-item-row">
                                <td>
                                    <select name="variantIds" class="form-select variant-select" required onchange="onVariantSelected(this)">
                                        <option value="">@(isArabic ? "اختر اللون والمخزون..." : "Select Variant (Stock)...")</option>
                                        @foreach (var p in products)
                                        {
                                            <optgroup label="@(isArabic && !string.IsNullOrWhiteSpace(p.ArabicName) ? p.ArabicName : p.Name)">
                                                @foreach (var v in p.Variants.Where(v => v.Quantity > 0))
                                                {
                                                    <option value="@v.Id" data-prodid="@p.Id" data-price="@(p.DiscountedPrice ?? p.Price)" data-stock="@v.Quantity">
                                                        @(isArabic && !string.IsNullOrWhiteSpace(v.ColorArabicName) ? v.ColorArabicName : v.ColorName) — @(isArabic ? $"المتوفر: {v.Quantity} قطعة" : $"Stock: {v.Quantity} pcs")
                                                    </option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                    <input type="hidden" name="productIds" class="hidden-prod-id" value="" />
                                </td>
                                <td>
                                    <input type="number" name="quantities" class="form-control text-center item-qty" min="1" value="1" required onchange="calcTotal()" />
                                </td>
                                <td>
                                    <input type="number" step="1" name="unitPrices" class="form-control item-price" value="0" required onchange="calcTotal()" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSaleRow(this)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Total Amount Summary Card -->
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between mt-3">
                    <span class="fs-5 fw-bold">@Localizer["GrandTotal"]</span>
                    <span class="fs-4 fw-extrabold text-success" id="grandTotalDisplay">0 @currency</span>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow">
                        <i class="bi bi-check-circle-fill me-2"></i> @Localizer["ConfirmSale"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    const currencyLabel = @Html.Raw(JsonSerializer.Serialize(currency));
    function onVariantSelected(selectElement) {
        const selectedOption = selectElement.options[selectElement.selectedIndex];
        const row = selectElement.closest('.sale-item-row');
        if (selectedOption && selectedOption.value) {
            const price = selectedOption.getAttribute('data-price');
            const prodId = selectedOption.getAttribute('data-prodid');
            const stock = parseInt(selectedOption.getAttribute('data-stock'), 10);

            row.querySelector('.hidden-prod-id').value = prodId;
            row.querySelector('.item-price').value = price;
            const qtyInput = row.querySelector('.item-qty');
            qtyInput.max = stock;
            if (parseInt(qtyInput.value, 10) > stock) {
                qtyInput.value = stock;
            }
        }
        calcTotal();
    }

    function addSaleRow() {
        const tbody = document.getElementById('saleItemsBody');
        const firstRow = tbody.querySelector('.sale-item-row');
        const newRow = firstRow.cloneNode(true);
        newRow.querySelector('.variant-select').selectedIndex = 0;
        newRow.querySelector('.hidden-prod-id').value = '';
        newRow.querySelector('.item-qty').value = 1;
        newRow.querySelector('.item-price').value = 0;
        tbody.appendChild(newRow);
        calcTotal();
    }

    function removeSaleRow(btn) {
        const rows = document.querySelectorAll('.sale-item-row');
        if (rows.length > 1) {
            btn.closest('tr').remove();
            calcTotal();
        } else {
            alert('@(isArabic ? "يجب إضافة صنف واحد على الأقل." : "At least one item is required.")');
        }
    }

    function calcTotal() {
        let total = 0;
        document.querySelectorAll('.sale-item-row').forEach(row => {
            const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
            const price = parseFloat(row.querySelector('.item-price').value) || 0;
            total += (qty * price);
        });
        document.getElementById('grandTotalDisplay').innerText = total.toLocaleString() + ' ' + currencyLabel;
    }

    document.addEventListener('DOMContentLoaded', calcTotal);
</script>
}
