@model List<CustomerRequestDto>
@{
    ViewData["Title"] = "Customer Inquiries & Callbacks";
    var selectedStatus = ViewBag.SelectedStatus as CustomerRequestStatus?;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Customer Callback & Hold Requests</h4>
        <p class="text-muted small mb-0">Follow up with customers who submitted hold requests or size inquiries.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm @(selectedStatus == null ? "btn-dark" : "btn-outline-secondary") rounded-pill">All</a>
        <a asp-action="Index" asp-route-status="@CustomerRequestStatus.New" class="btn btn-sm @(selectedStatus == CustomerRequestStatus.New ? "btn-warning" : "btn-outline-warning") rounded-pill">New</a>
        <a asp-action="Index" asp-route-status="@CustomerRequestStatus.Contacted" class="btn btn-sm @(selectedStatus == CustomerRequestStatus.Contacted ? "btn-info" : "btn-outline-info") rounded-pill">Contacted</a>
        <a asp-action="Index" asp-route-status="@CustomerRequestStatus.Completed" class="btn btn-sm @(selectedStatus == CustomerRequestStatus.Completed ? "btn-success" : "btn-outline-success") rounded-pill">Completed</a>
    </div>
</div>

<div class="card-custom p-0 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer Info</th>
                    <th>Product</th>
                    <th>Message / Request</th>
                    <th>Status</th>
                    <th class="text-end">Actions & Update</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No customer requests in this view.</td>
                    </tr>
                }
                @foreach (var req in Model)
                {
                    <tr>
                        <td class="small text-muted">@req.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>
                            <div class="fw-bold">@req.CustomerName</div>
                            <div class="small text-muted">@req.PhoneNumber</div>
                            <span class="badge bg-light text-dark border extra-small">@req.PreferredChannel</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(req.ProductName))
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-dark fw-bold">@req.ProductName</span>
                            }
                            else
                            {
                                <span class="text-muted small">General Inquiry</span>
                            }
                        </td>
                        <td class="small" style="max-width: 250px;">
                            @(req.Message ?? "—")
                            @if (!string.IsNullOrWhiteSpace(req.AdminNotes))
                            {
                                <div class="text-muted extra-small mt-1 fst-italic">Note: @req.AdminNotes</div>
                            }
                        </td>
                        <td>
                            @if (req.Status == CustomerRequestStatus.New)
                            {
                                <span class="badge bg-warning text-dark">New</span>
                            }
                            else if (req.Status == CustomerRequestStatus.Contacted)
                            {
                                <span class="badge bg-info text-white">Contacted</span>
                            }
                            else if (req.Status == CustomerRequestStatus.Completed)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2 align-items-center">
                                <a href="https://wa.me/@req.PhoneNumber" target="_blank" class="btn btn-sm btn-success rounded-circle" title="Chat on WhatsApp">
                                    <i class="bi bi-whatsapp"></i>
                                </a>
                                <a href="tel:@req.PhoneNumber" class="btn btn-sm btn-outline-primary rounded-circle" title="Call Customer">
                                    <i class="bi bi-telephone"></i>
                                </a>
                                <!-- Quick Status Dropdown Modal Trigger -->
                                <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" data-bs-toggle="modal" data-bs-target="#updateModal-@req.Id">
                                    Update
                                </button>
                            </div>

                            <!-- Update Modal -->
                            <div class="modal fade text-start" id="updateModal-@req.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4">
                                        <div class="modal-header">
                                            <h6 class="modal-title fw-bold">Update Request — @req.CustomerName</h6>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="UpdateStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-bold">Status</label>
                                                    <select name="status" class="form-select">
                                                        <option value="@CustomerRequestStatus.New" selected="@(req.Status == CustomerRequestStatus.New)">New</option>
                                                        <option value="@CustomerRequestStatus.Contacted" selected="@(req.Status == CustomerRequestStatus.Contacted)">Contacted (In Progress)</option>
                                                        <option value="@CustomerRequestStatus.Completed" selected="@(req.Status == CustomerRequestStatus.Completed)">Completed (Order Placed)</option>
                                                        <option value="@CustomerRequestStatus.Cancelled" selected="@(req.Status == CustomerRequestStatus.Cancelled)">Cancelled / Not Interested</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-bold">Admin Follow-up Notes</label>
                                                    <textarea name="adminNotes" class="form-control" rows="2" placeholder="e.g. Spoke on WhatsApp, customer wants size XL next week">@req.AdminNotes</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Save Update</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
