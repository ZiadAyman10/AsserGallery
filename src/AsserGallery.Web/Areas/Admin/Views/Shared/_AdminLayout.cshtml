@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var currentLang = isRtl ? "ar" : "en";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="@currentLang" dir="@(isRtl ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin — @Localizer["AppName"]</title>
    
    <!-- Bootstrap CSS (RTL/LTR Aware) -->
    @if (isRtl)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    }
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Design System Layer -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }
        .admin-sidebar {
            width: 260px;
            background: var(--bg-surface);
            border-inline-end: 1px solid var(--border-main);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: var(--transition);
        }
        .admin-content {
            flex-grow: 1;
            background: var(--bg-main);
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .admin-header {
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border-main);
            padding: 0.85rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1010;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 1.25rem;
            color: var(--text-muted);
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            border-radius: var(--radius-sm);
            margin: 0.15rem 0.75rem;
            transition: var(--transition);
        }
        .sidebar-link:hover, .sidebar-link.active {
            color: var(--text-main);
            background: var(--bg-surface-subtle);
            font-weight: 600;
        }
        .sidebar-link.active {
            border-inline-start: 3px solid var(--accent);
        }
        .sidebar-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            padding: 1rem 1.5rem 0.35rem;
        }
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                inset-inline-start: -260px;
                z-index: 1040;
                box-shadow: var(--shadow-lg);
            }
            .admin-sidebar.show {
                inset-inline-start: 0;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Brand -->
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--border-main) !important;">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-logo fs-5">
                    <span class="badge-logo">AG</span>
                    <span>@Localizer["AdminPanel"]</span>
                </a>
                <button type="button" class="btn-close d-lg-none" onclick="document.getElementById('adminSidebar').classList.remove('show')"></button>
            </div>

            <!-- Links -->
            <div class="flex-grow-1 overflow-y-auto py-2">
                <div class="sidebar-section-title">@Localizer["Operations"]</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(currentCtrl == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i> @Localizer["Dashboard"]
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="sidebar-link @(currentCtrl == "Products" ? "active" : "")">
                    <i class="bi bi-tags"></i> @Localizer["ProductsAndStock"]
                </a>
                <a asp-area="Admin" asp-controller="Sales" asp-action="Index" class="sidebar-link @(currentCtrl == "Sales" ? "active" : "")">
                    <i class="bi bi-cart-check"></i> @Localizer["SalesAndOrders"]
                </a>
                <a asp-area="Admin" asp-controller="Finances" asp-action="Index" class="sidebar-link @(currentCtrl == "Finances" ? "active" : "")">
                    <i class="bi bi-cash-stack"></i> @Localizer["IncomeAndExpenses"]
                </a>

                <div class="sidebar-section-title">@Localizer["CustomerAndVisibility"]</div>
                <a asp-area="Admin" asp-controller="CustomerRequests" asp-action="Index" class="sidebar-link @(currentCtrl == "CustomerRequests" ? "active" : "")">
                    <i class="bi bi-people"></i> @Localizer["CustomerRequests"]
                </a>
                <a asp-area="Admin" asp-controller="Facebook" asp-action="Index" class="sidebar-link @(currentCtrl == "Facebook" ? "active" : "")">
                    <i class="bi bi-facebook"></i> @Localizer["FacebookPublishing"]
                </a>
                <a asp-area="Admin" asp-controller="ImageGuide" asp-action="Index" class="sidebar-link @(currentCtrl == "ImageGuide" ? "active" : "")">
                    <i class="bi bi-camera"></i> @Localizer["PhotoAndAiGuide"]
                </a>

                <div class="sidebar-section-title">@Localizer["Configuration"]</div>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="sidebar-link @(currentCtrl == "Categories" ? "active" : "")">
                    <i class="bi bi-diagram-3"></i> @Localizer["Categories"]
                </a>
                <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="sidebar-link @(currentCtrl == "Settings" ? "active" : "")">
                    <i class="bi bi-sliders"></i> @Localizer["StoreSettings"]
                </a>
            </div>

            <!-- Footer / Back to Public -->
            <div class="p-3 border-top" style="border-color: var(--border-main) !important;">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 mb-2">
                    <i class="bi bi-box-arrow-up-right me-1"></i> @Localizer["ViewPublicStore"]
                </a>
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> @Localizer["Logout"]
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-content">
            <!-- Header -->
            <header class="admin-header">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('adminSidebar').classList.add('show')">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- Language Switcher -->
                    @if (isRtl)
                    {
                        <a href="/Culture/SetLanguage?culture=en&returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn-lang-toggle" title="Switch to English">
                            <i class="bi bi-globe"></i> English
                        </a>
                    }
                    else
                    {
                        <a href="/Culture/SetLanguage?culture=ar&returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn-lang-toggle" title="التحويل للغة العربية">
                            <i class="bi bi-globe"></i> العربية
                        </a>
                    }

                    <!-- Theme Toggle -->
                    <button class="btn-theme-toggle" type="button" onclick="toggleTheme()" title="Toggle Theme">
                        <i class="bi bi-sun-fill theme-icon-sun text-warning" style="display:none;"></i>
                        <i class="bi bi-moon-stars-fill theme-icon-moon text-primary"></i>
                    </button>

                    <!-- User Pill -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-md-inline small fw-semibold">Admin</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>@Localizer["Settings"]</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none"><i class="bi bi-box-arrow-right me-2"></i>@Localizer["Logout"]</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Body -->
            <main class="p-3 p-md-4 flex-grow-1">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
