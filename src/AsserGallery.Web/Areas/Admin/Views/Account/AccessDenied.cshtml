@using System.Globalization
@{
    Layout = "_Layout";
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "غير مصرح بالدخول" : "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card-custom p-4 p-md-5 shadow-lg border-0">
            <div class="mb-3">
                <span class="p-3 rounded-circle bg-danger bg-opacity-10 text-danger fs-1 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-slash-fill"></i>
                </span>
            </div>
            
            <h3 class="fw-bold mb-2">@(isArabic ? "غير مصرح بالدخول" : "Access Denied")</h3>
            <p class="text-muted small mb-4">
                @(isArabic ? "عفواً، لا تملك الصلاحيات الكافية للوصول إلى هذه الصفحة. يرجى تسجيل الدخول بحساب مسؤول المتجر." : "You do not have permission to access this resource. Please sign in with an Administrator account.")
            </p>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-dark rounded-pill px-4 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> @(isArabic ? "تسجيل الدخول كمسؤول" : "Login as Admin")
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-house me-1"></i> @(isArabic ? "العودة للمتجر الرئيسي" : "Back to Home")
                </a>
            </div>
        </div>
    </div>
</div>
