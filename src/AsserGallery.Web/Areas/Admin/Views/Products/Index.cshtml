@model AsserGallery.Application.Common.Models.PaginatedList<ProductDto>
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "إدارة المنتجات والمخزون" : "Product Inventory";
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
    var selectedCatId = ViewBag.CategoryId as int?;
    var selectedStatus = ViewBag.Status as ProductStatus?;
    var search = ViewBag.Search as string;
    var curr = isArabic ? "ج.م" : "EGP";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">@(isArabic ? "المنتجات والمخزون" : "Products & Stock")</h4>
        <p class="text-muted small mb-0">@(isArabic ? "إدارة ملابس المتجر، تتبع المخزون لكل لون، وتحديث الأسعار." : "Manage your clothing items, multi-color stock levels, and pricing.")</p>
    </div>
    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> @(isArabic ? "إضافة منتج جديد" : "Add New Product")
    </a>
</div>

<!-- Filter Bar -->
<div class="card-custom p-3 mb-4">
    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="@(isArabic ? "ابحث بالاسم أو الوصف..." : "Search by name, description...")" />
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">@(isArabic ? "جميع الأقسام" : "All Categories")</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(selectedCatId == cat.Id)">@(isArabic ? cat.ArabicName : cat.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">@(isArabic ? "جميع الحالات" : "All Statuses")</option>
                    <option value="@ProductStatus.Available" selected="@(selectedStatus == ProductStatus.Available)">@(isArabic ? "متوفر" : "Available")</option>
                    <option value="@ProductStatus.LimitedStock" selected="@(selectedStatus == ProductStatus.LimitedStock)">@(isArabic ? "كمية محدودة" : "Limited Stock")</option>
                    <option value="@ProductStatus.OutOfStock" selected="@(selectedStatus == ProductStatus.OutOfStock)">@(isArabic ? "نفدت الكمية" : "Out of Stock")</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-dark w-100">@(isArabic ? "تصفية" : "Filter")</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@(isArabic ? "إلغاء" : "Reset")</a>
            </div>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="card-custom p-0 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;">@(isArabic ? "الصورة" : "Image")</th>
                    <th>@(isArabic ? "اسم المنتج" : "Product Name")</th>
                    <th>@(isArabic ? "القسم" : "Category")</th>
                    <th>@(isArabic ? "السعر" : "Price")</th>
                    <th>@(isArabic ? "ألوان ومخزون الموديل" : "Color Stock Matrix")</th>
                    <th>@(isArabic ? "إجمالي المخزون" : "Total Stock")</th>
                    <th>@(isArabic ? "الحالة" : "Status")</th>
                    <th class="text-end" style="width: 140px;">@(isArabic ? "الإجراءات" : "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">@(isArabic ? "لم يتم العثور على منتجات." : "No products found.")</td>
                    </tr>
                }
                @foreach (var prod in Model.Items)
                {
                    <tr>
                        <td>
                            <img src="@(prod.PrimaryImageUrl ?? "https://via.placeholder.com/60")" alt="@(isArabic ? prod.ArabicName : prod.Name)" class="rounded-3 object-fit-cover" style="width: 50px; height: 50px;" />
                        </td>
                        <td>
                            <div class="fw-bold">@(isArabic ? prod.ArabicName : prod.Name)</div>
                            <div class="text-muted small">@(isArabic ? prod.Name : prod.ArabicName)</div>
                            @if (prod.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark small"><i class="bi bi-star-fill"></i> @(isArabic ? "مميز بالرئيسية" : "Featured")</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-surface-subtle text-main border">
                                @(isArabic ? $"{prod.CategoryArabicName} / {prod.SubCategoryArabicName}" : $"{prod.CategoryName} / {prod.SubCategoryName}")
                            </span>
                        </td>
                        <td>
                            <div class="fw-bold">@((prod.DiscountedPrice ?? prod.Price).ToString("N0")) @curr</div>
                            @if (prod.DiscountedPrice.HasValue)
                            {
                                <div class="text-muted small text-decoration-line-through">@prod.Price.ToString("N0") @curr</div>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var v in prod.Variants)
                                {
                                    <span class="badge @(v.Quantity > 0 ? "bg-surface-subtle text-main border" : "bg-danger text-white") small d-inline-flex align-items-center gap-1">
                                        <span class="color-dot" style="width: 8px; height: 8px; background-color: @v.ColorHexCode;"></span>
                                        <span>@(isArabic ? v.ColorArabicName : v.ColorName): <strong>@v.Quantity</strong></span>
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            <strong class="fs-6 @(prod.TotalStock > 3 ? "text-success" : (prod.TotalStock > 0 ? "text-warning" : "text-danger"))">
                                @prod.TotalStock
                            </strong>
                        </td>
                        <td>
                            @if (prod.Status == ProductStatus.Available)
                            {
                                <span class="status-badge status-available">@(isArabic ? "متوفر" : "Available")</span>
                            }
                            else if (prod.Status == ProductStatus.LimitedStock)
                            {
                                <span class="status-badge status-limited">@(isArabic ? "كمية محدودة" : "Limited")</span>
                            }
                            else
                            {
                                <span class="status-badge status-outofstock">@(isArabic ? "نفدت الكمية" : "Out of Stock")</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-area="Admin" asp-controller="Facebook" asp-action="GroupAssistant" asp-route-productId="@prod.Id" class="btn btn-sm btn-outline-primary" title="@(isArabic ? "مساعد النشر في فيسبوك" : "Facebook Post Helper")">
                                    <i class="bi bi-facebook"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-dark" title="@(isArabic ? "تعديل" : "Edit")">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@prod.Id" method="post" class="d-inline" onsubmit="return confirm('@(isArabic ? "هل أنت متأكد من حذف هذا المنتج؟" : "Are you sure you want to delete this product?")');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="@(isArabic ? "حذف" : "Delete")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
