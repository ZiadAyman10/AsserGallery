@model List<CategoryDto>
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["CategoriesManagement"].Value;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Localizer["CategoriesManagement"]</h4>
        <p class="text-muted small mb-0">@Localizer["ManageCategoriesDescription"]</p>
    </div>
    <button type="button" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="bi bi-plus-lg me-1"></i> @Localizer["AddNewCategory"]
    </button>
</div>

<div class="row g-4 mb-4">
    @foreach (var cat in Model)
    {
        <div class="col-lg-6">
            <div class="card-custom p-4 h-100 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                    <div>
                        <h5 class="fw-bold mb-0">@(isArabic && !string.IsNullOrWhiteSpace(cat.ArabicName) ? cat.ArabicName : cat.Name)</h5>
                        <div class="text-muted small">@(isArabic ? cat.Name : cat.ArabicName)</div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addSubCategoryModal-@cat.Id">
                            <i class="bi bi-plus-circle me-1"></i> @Localizer["AddNewSubCategory"]
                        </button>
                        <form asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('@(isArabic ? "حذف هذا القسم وكافة الأقسام الفرعية التابعة له؟" : "Delete this entire category and its subcategories?")');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="@Localizer["Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <h6 class="fw-bold small text-muted text-uppercase mb-2">@Localizer["SubCategoriesCount"] (@cat.SubCategories.Count)</h6>
                <div class="d-flex flex-column gap-2 mb-3 flex-grow-1">
                    @if (!cat.SubCategories.Any())
                    {
                        <p class="text-muted small my-2">@(isArabic ? "لا توجد أقسام فرعية مضافة بعد." : "No subcategories defined yet.")</p>
                    }
                    @foreach (var sub in cat.SubCategories)
                    {
                        <div class="p-2 px-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fw-bold small">@(isArabic && !string.IsNullOrWhiteSpace(sub.ArabicName) ? sub.ArabicName : sub.Name)</span>
                                <span class="text-muted small ms-2">(@(isArabic ? sub.Name : sub.ArabicName))</span>
                            </div>
                            <span class="badge bg-secondary rounded-pill">@sub.ProductCount @(isArabic ? "منتج" : "products")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Add SubCategory Modal -->
        <div class="modal fade text-start" id="addSubCategoryModal-@cat.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4">
                    <div class="modal-header">
                        <h6 class="modal-title fw-bold">@(isArabic ? $"إضافة قسم فرعي إلى {cat.ArabicName}" : $"Add SubCategory to {cat.Name}")</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="CreateSubCategory" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="categoryId" value="@cat.Id" />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">@(isArabic ? "اسم القسم الفرعي (بالإنجليزية) *" : "SubCategory Name (EN) *")</label>
                                <input type="text" name="name" class="form-control" required placeholder="e.g. Formal Shirts" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">@(isArabic ? "اسم القسم الفرعي (بالعربية) *" : "Arabic Name *")</label>
                                <input type="text" name="arabicName" class="form-control text-end" required placeholder="مثال: قمصان رسمية" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">@Localizer["DisplayOrder"]</label>
                                <input type="number" name="displayOrder" class="form-control" value="1" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">@(isArabic ? "إلغاء" : "Cancel")</button>
                            <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">@(isArabic ? "إنشاء القسم الفرعي" : "Create SubCategory")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Main Category Modal -->
<div class="modal fade text-start" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">@Localizer["AddNewCategory"]</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isArabic ? "اسم القسم الرئيسي (بالإنجليزية) *" : "Category Name (EN) *")</label>
                        <input type="text" name="name" class="form-control" required placeholder="e.g. Footwear & Shoes" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isArabic ? "اسم القسم الرئيسي (بالعربية) *" : "Arabic Name *")</label>
                        <input type="text" name="arabicName" class="form-control text-end" required placeholder="مثال: أحذية وكوتشيات" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@Localizer["DisplayOrder"]</label>
                        <input type="number" name="displayOrder" class="form-control" value="1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">@(isArabic ? "إلغاء" : "Cancel")</button>
                    <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">@(isArabic ? "إنشاء القسم الرئيسي" : "Create Category")</button>
                </div>
            </form>
        </div>
    </div>
</div>
