@model List<FacebookDestinationDto>
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["FacebookPublishingCenter"].Value;
    var products = ViewBag.Products as IReadOnlyList<ProductDto> ?? new List<ProductDto>();
    var currency = Localizer["Currency"].Value;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Localizer["FacebookPublishingCenter"]</h4>
        <p class="text-muted small mb-0">@Localizer["FacebookPublishingDescription"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="GroupAssistant" class="btn btn-primary rounded-pill px-3 fw-bold">
            <i class="bi bi-people-fill me-1"></i> @Localizer["GroupPostingAssistant"]
        </a>
        <button type="button" class="btn btn-dark rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addDestinationModal">
            <i class="bi bi-plus-lg me-1"></i> @Localizer["AddDestination"]
        </button>
    </div>
</div>

<!-- Architecture & Meta API Info Alert (§4.9) -->
<div class="alert alert-info border-0 rounded-4 p-4 shadow-sm mb-4">
    <div class="d-flex gap-3">
        <i class="bi bi-info-circle-fill fs-3 text-info"></i>
        <div>
            <h6 class="fw-bold mb-1">@Localizer["MetaApiBannerTitle"]</h6>
            <p class="small mb-0 opacity-90">
                @Localizer["MetaApiBannerDesc"]
            </p>
        </div>
    </div>
</div>

<!-- Destinations Grid -->
<div class="row g-3 mb-4">
    @foreach (var dest in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card-custom p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge @(dest.DestinationType == DestinationType.Page ? "bg-primary" : "bg-success") rounded-pill">
                            <i class="bi @(dest.DestinationType == DestinationType.Page ? "bi-flag-fill" : "bi-people-fill") me-1"></i>
                            @(dest.DestinationType == DestinationType.Page ? Localizer["Page"].Value : Localizer["Group"].Value)
                        </span>
                        <span class="text-muted extra-small">@dest.PostCount @Localizer["PostsLogged"]</span>
                    </div>
                    <h6 class="fw-bold mb-1">@dest.Name</h6>
                    <p class="text-muted extra-small text-truncate mb-3">@Localizer["Target"] @dest.TargetIdOrUrl</p>
                </div>

                <div class="pt-2 border-top">
                    @if (dest.DestinationType == DestinationType.Group)
                    {
                        <a asp-action="GroupAssistant" asp-route-destinationId="@dest.Id" class="btn btn-sm btn-outline-success w-100 rounded-pill fw-bold">
                            <i class="bi bi-magic me-1"></i> @Localizer["OpenAssistant"]
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#publishPageModal-@dest.Id">
                            <i class="bi bi-send me-1"></i> @Localizer["PublishAnnouncement"]
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Publish to Page Modal -->
        @if (dest.DestinationType == DestinationType.Page)
        {
            <div class="modal fade text-start" id="publishPageModal-@dest.Id" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4">
                        <div class="modal-header">
                            <h6 class="modal-title fw-bold">@(isArabic ? $"النشر في {dest.Name}" : $"Publish to {dest.Name}")</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="PublishPage" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="destinationId" value="@dest.Id" />
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">@(isArabic ? "اختر المنتج" : "Select Product")</label>
                                    <select name="productId" class="form-select" required>
                                        @foreach (var p in products)
                                        {
                                            <option value="@p.Id">
                                                @(isArabic && !string.IsNullOrWhiteSpace(p.ArabicName) ? p.ArabicName : p.Name) — @((p.DiscountedPrice ?? p.Price).ToString("N0")) @currency
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">@(isArabic ? "نص المنشور / الرسالة" : "Post Caption / Message")</label>
                                    <textarea name="message" class="form-control" rows="4" required placeholder="@(isArabic ? "🔥 وصل حديثاً! استكشف أحدث تشكيلة لصيف 2026..." : "🔥 New Collection Alert! Check out our new summer arrivals...")"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">@(isArabic ? "إلغاء" : "Cancel")</button>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">
                                    <i class="bi bi-send-fill me-1"></i> @(isArabic ? "نشر في الصفحة" : "Post to Page")
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Add Destination Modal -->
<div class="modal fade text-start" id="addDestinationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">@(isArabic ? "إضافة وجهة نشر على فيسبوك" : "Add Facebook Target Destination")</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateDestination" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isArabic ? "اسم الوجهة *" : "Destination Name *")</label>
                        <input type="text" name="name" class="form-control" required placeholder="@(isArabic ? "مثال: جروب عروض القاهرة VIP" : "e.g. Cairo VIP Fashion Deals")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isArabic ? "نوع الوجهة *" : "Destination Type *")</label>
                        <select name="destinationType" class="form-select" required>
                            <option value="@DestinationType.Group">@(isArabic ? "جروب فيسبوك (مساعد النشر)" : "Facebook Group (Manual Assistant)")</option>
                            <option value="@DestinationType.Page">@(isArabic ? "صفحة فيسبوك (Graph API)" : "Facebook Page (Graph API)")</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isArabic ? "معرف الصفحة أو رابط الجروب *" : "Page ID or Group URL Slug *")</label>
                        <input type="text" name="targetIdOrUrl" class="form-control" required placeholder="e.g. groups/cairodeals or 109283..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@(isArabic ? "رمز الوصول للصفحة (Access Token) — اختياري" : "Page Access Token (For Pages Only)")</label>
                        <input type="password" name="accessToken" class="form-control" placeholder="EAAB..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">@(isArabic ? "إلغاء" : "Cancel")</button>
                    <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">@(isArabic ? "حفظ الوجهة" : "Save Destination")</button>
                </div>
            </form>
        </div>
    </div>
</div>
