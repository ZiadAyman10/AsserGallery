@model List<FacebookDestinationDto>
@{
    ViewData["Title"] = "Facebook Publishing & Groups Center";
    var products = ViewBag.Products as IReadOnlyList<ProductDto> ?? new List<ProductDto>();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Facebook Publishing Center</h4>
        <p class="text-muted small mb-0">Automated Page publishing via Graph API & manual assistant for Facebook Groups.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="GroupAssistant" class="btn btn-primary rounded-pill px-3 fw-bold">
            <i class="bi bi-people-fill me-1"></i> Group Posting Assistant
        </a>
        <button type="button" class="btn btn-dark rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addDestinationModal">
            <i class="bi bi-plus-lg me-1"></i> Add Destination
        </a>
    </div>
</div>

<!-- Architecture & Meta API Info Alert (§4.9) -->
<div class="alert alert-info border-0 rounded-4 p-4 shadow-sm mb-4">
    <div class="d-flex gap-3">
        <i class="bi bi-info-circle-fill fs-3 text-info"></i>
        <div>
            <h6 class="fw-bold mb-1">Meta API Publishing Architecture (§4.9)</h6>
            <p class="small mb-0 opacity-90">
                • <strong>Facebook Pages:</strong> Fully automated via official Graph API endpoints with one-click multi-page broadcasts.<br />
                • <strong>Facebook Groups:</strong> As Meta discontinued the Groups API, our <strong>Posting Assistant</strong> formats attractive post copy with pricing, emojis & WhatsApp links, opens the group page directly, and tracks your manual posting confirmations.
            </p>
        </div>
    </div>
</div>

<!-- Destinations Grid -->
<div class="row g-3 mb-4">
    @foreach (var dest in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card-custom p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge @(dest.DestinationType == DestinationType.Page ? "bg-primary" : "bg-success") rounded-pill">
                            <i class="bi @(dest.DestinationType == DestinationType.Page ? "bi-flag-fill" : "bi-people-fill") me-1"></i>
                            @dest.DestinationType
                        </span>
                        <span class="text-muted extra-small">@dest.PostCount post(s) logged</span>
                    </div>
                    <h6 class="fw-bold mb-1">@dest.Name</h6>
                    <p class="text-muted extra-small text-truncate mb-3">Target: @dest.TargetIdOrUrl</p>
                </div>

                <div class="pt-2 border-top">
                    @if (dest.DestinationType == DestinationType.Group)
                    {
                        <a asp-action="GroupAssistant" asp-route-destinationId="@dest.Id" class="btn btn-sm btn-outline-success w-100 rounded-pill fw-bold">
                            <i class="bi bi-magic me-1"></i> Open Assistant
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#publishPageModal-@dest.Id">
                            <i class="bi bi-send me-1"></i> Publish Announcement
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Publish to Page Modal -->
        @if (dest.DestinationType == DestinationType.Page)
        {
            <div class="modal fade" id="publishPageModal-@dest.Id" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4">
                        <div class="modal-header">
                            <h6 class="modal-title fw-bold">Publish to @dest.Name</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="PublishPage" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="destinationId" value="@dest.Id" />
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Select Product</label>
                                    <select name="productId" class="form-select" required>
                                        @foreach (var p in products)
                                        {
                                            <option value="@p.Id">@p.Name (@p.ArabicName) — @((p.DiscountedPrice ?? p.Price).ToString("N0")) EGP</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Post Caption / Message</label>
                                    <textarea name="message" class="form-control" rows="4" required placeholder="🔥 New Collection Alert! Check out our new summer arrivals..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">
                                    <i class="bi bi-send-fill me-1"></i> Post to Page
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Add Destination Modal -->
<div class="modal fade" id="addDestinationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Add Facebook Target Destination</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateDestination" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Destination Name *</label>
                        <input type="text" name="name" class="form-control" required placeholder="e.g. Cairo VIP Fashion Deals" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Destination Type *</label>
                        <select name="destinationType" class="form-select" required>
                            <option value="@DestinationType.Group">Facebook Group (Manual Assistant)</option>
                            <option value="@DestinationType.Page">Facebook Page (Graph API)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Page ID or Group URL Slug *</label>
                        <input type="text" name="targetIdOrUrl" class="form-control" required placeholder="e.g. groups/cairodeals or PageID 109283..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Page Access Token (For Pages Only)</label>
                        <input type="password" name="accessToken" class="form-control" placeholder="EAAB..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Save Destination</button>
                </div>
            </form>
        </div>
    </div>
</div>
