@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["RecordTransaction"].Value;
    var products = ViewBag.Products as IReadOnlyList<ProductDto> ?? new List<ProductDto>();
    var currency = Localizer["Currency"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Localizer["RecordTransaction"]</h4>
        <p class="text-muted small mb-0">@(isArabic ? "إضافة إيراد مالي أو تسجيل مصروفات تشغيلية (بضاعة، تغليف، إعلانات، شحن)." : "Add an income or operational expense (packaging, ads, stock purchase, etc.).")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-@(isArabic ? "right" : "left") me-1"></i> @(isArabic ? "العودة للمالية" : "Back to Finances")
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isArabic ? "نوع المعاملة *" : "Transaction Type *")</label>
                        <select name="type" class="form-select" required>
                            <option value="@TransactionType.Expense">@(isArabic ? "مصروف (Expense)" : "Expense")</option>
                            <option value="@TransactionType.Income">@(isArabic ? "إيراد (Income)" : "Income")</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isArabic ? "التصنيف / البند *" : "Category *")</label>
                        <select name="category" class="form-select" required>
                            <option value="StockPurchase">@(isArabic ? "مشتريات بضاعة وقماش (Stock Purchase)" : "Stock Purchase")</option>
                            <option value="Packaging">@(isArabic ? "أكياس وتغليف (Packaging)" : "Packaging")</option>
                            <option value="Advertising">@(isArabic ? "إعلانات وفيسبوك (Advertising)" : "Advertising")</option>
                            <option value="Delivery">@(isArabic ? "شحن ومواصلات (Delivery & Logistics)" : "Delivery & Logistics")</option>
                            <option value="SalesRevenue">@(isArabic ? "إيراد مبيعات (Sales Revenue)" : "Sales Revenue")</option>
                            <option value="Other">@(isArabic ? "مصروفات أخرى (Other Expenses)" : "Other Expenses")</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-bold">@(isArabic ? "بيان المعاملة / العنوان *" : "Title / Purpose *")</label>
                        <input type="text" name="title" class="form-control" required placeholder="@(isArabic ? "مثال: طباعة 500 كيس شوبنج فاخر" : "e.g. 500 Custom Glossy Bags")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">@(isArabic ? $"المبلغ ({currency}) *" : $"Amount ({currency}) *")</label>
                        <input type="number" step="0.5" name="amount" class="form-control" required placeholder="1500" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isArabic ? "التاريخ" : "Date")</label>
                        <input type="datetime-local" name="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@(isArabic ? "ربط بمنتج محدد (اختياري)" : "Linked Product (Optional)")</label>
                        <select name="linkedProductId" class="form-select">
                            <option value="">@(isArabic ? "بدون ربط (مصروف متجر عام)" : "None (General Store Expense)")</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">
                                    @(isArabic && !string.IsNullOrWhiteSpace(p.ArabicName) ? p.ArabicName : p.Name)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold">@(isArabic ? "ملاحظات وتفاصيل الفاتورة" : "Description / Receipt Notes")</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="@(isArabic ? "اسم المورد، رقم الإيصال، طريقة الدفع..." : "Supplier name, invoice details...")"></textarea>
                    </div>

                    <div class="col-12 mt-4 text-end">
                        <button type="submit" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow">
                            <i class="bi bi-check-circle me-1"></i> @(isArabic ? "حفظ المعاملة المالية" : "Save Transaction")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
