@model List<FinancialTransactionDto>
@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = Localizer["FinancialTransactions"].Value;
    var summary = ViewBag.Summary as FinancialSummaryDto;
    var selectedType = ViewBag.SelectedType as TransactionType?;
    var currency = Localizer["Currency"].Value;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Localizer["FinancialManagement"]</h4>
        <p class="text-muted small mb-0">@Localizer["ManageFinancesDescription"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-type="@selectedType" class="btn btn-outline-success rounded-pill px-3 fw-bold shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> @Localizer["ExportCsvExcel"]
        </a>
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> @Localizer["RecordTransaction"]
        </a>
    </div>
</div>

<!-- Financial KPI Summary Cards -->
@if (summary != null)
{
    <div class="row g-3 mb-4">
        <!-- Total Income -->
        <div class="col-sm-6 col-lg-4">
            <div class="stat-kpi-card border-start border-4 border-success">
                <div class="stat-kpi-label">@Localizer["TotalIncomeRevenue"]</div>
                <div class="stat-kpi-value text-success">@summary.TotalIncome.ToString("N0") <small class="fs-6 fw-normal">@currency</small></div>
                <div class="text-muted extra-small mt-1">@Localizer["ThisMonth"] +@summary.ThisMonthIncome.ToString("N0") @currency</div>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="col-sm-6 col-lg-4">
            <div class="stat-kpi-card border-start border-4 border-danger">
                <div class="stat-kpi-label">@Localizer["TotalExpenses"]</div>
                <div class="stat-kpi-value text-danger">@summary.TotalExpense.ToString("N0") <small class="fs-6 fw-normal">@currency</small></div>
                <div class="text-muted extra-small mt-1">@Localizer["ThisMonth"] -@summary.ThisMonthExpense.ToString("N0") @currency</div>
            </div>
        </div>

        <!-- Net Profit -->
        <div class="col-sm-12 col-lg-4">
            <div class="stat-kpi-card border-start border-4 @(summary.NetProfit >= 0 ? "border-primary" : "border-warning")">
                <div class="stat-kpi-label">@Localizer["NetProfitBalance"]</div>
                <div class="stat-kpi-value @(summary.NetProfit >= 0 ? "text-primary" : "text-danger")">
                    @summary.NetProfit.ToString("N0") <small class="fs-6 fw-normal">@currency</small>
                </div>
                <div class="text-muted extra-small mt-1">@Localizer["ThisMonthProfit"] @summary.ThisMonthNetProfit.ToString("N0") @currency</div>
            </div>
        </div>
    </div>
}

<!-- Transactions List -->
<div class="card-custom p-0 overflow-hidden mb-4">
    <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0">@Localizer["TransactionRecords"]</h5>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-sm @(selectedType == null ? "btn-dark" : "btn-outline-secondary") rounded-pill">@Localizer["All"]</a>
            <a asp-action="Index" asp-route-type="@TransactionType.Income" class="btn btn-sm @(selectedType == TransactionType.Income ? "btn-success" : "btn-outline-success") rounded-pill">@Localizer["IncomeOnly"]</a>
            <a asp-action="Index" asp-route-type="@TransactionType.Expense" class="btn btn-sm @(selectedType == TransactionType.Expense ? "btn-danger" : "btn-outline-danger") rounded-pill">@Localizer["ExpensesOnly"]</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["TitleAndDescription"]</th>
                    <th>@Localizer["Category"]</th>
                    <th>@Localizer["LinkedProduct"]</th>
                    <th>@Localizer["Type"]</th>
                    <th class="text-end">@Localizer["Amount"]</th>
                    <th class="text-end">@Localizer["Action"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">@Localizer["NoTransactionsFound"]</td>
                    </tr>
                }
                @foreach (var tx in Model)
                {
                    <tr>
                        <td class="small text-muted">@tx.Date.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="fw-bold">@tx.Title</div>
                            @if (!string.IsNullOrWhiteSpace(tx.Description))
                            {
                                <div class="text-muted extra-small">@tx.Description</div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(isArabic ? (tx.Category switch {
                                    "SalesRevenue" => "إيرادات مبيعات",
                                    "Advertising" => "إعلانات وتسويق",
                                    "Packaging" => "تغليف وطباعة",
                                    "StockPurchase" => "شراء بضاعة وقماش",
                                    "Delivery" => "شحن وتوصيل",
                                    _ => tx.Category
                                }) : tx.Category)
                            </span>
                        </td>
                        <td class="small">
                            @(tx.LinkedProductName ?? "—")
                        </td>
                        <td>
                            @if (tx.Type == TransactionType.Income)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">@Localizer["Income"]</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">@Localizer["Expense"]</span>
                            }
                        </td>
                        <td class="text-end fw-bold fs-6 @(tx.Type == TransactionType.Income ? "text-success" : "text-danger")">
                            @(tx.Type == TransactionType.Income ? "+" : "-")@tx.Amount.ToString("N0") @currency
                        </td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@tx.Id" method="post" class="d-inline" onsubmit="return confirm('@Localizer["ConfirmDeleteTransaction"]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
